# Applied when PlatformIO generates sdkconfig.xiao_c5 (git-ignored).
# Delete sdkconfig.xiao_c5 to re-apply after editing this file.

CONFIG_IDF_TARGET="esp32c5"

# XIAO ESP32-C5: 8 MB flash, DIO only (does not boot in QIO).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Console on the native USB Serial/JTAG port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 1 ms tick: RSSI output and SPI handling want ms-level scheduling.
CONFIG_FREERTOS_HZ=1000

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Radio as a receive-only front end (settings from C5VRX's sdkconfig.defaults,
# github.com/Twotoz/C5VRX @ 14e190d). Wi-Fi carries no traffic: it only keeps
# the RF/PHY running so MODEM_DIAG streams I/Q.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
# Power management while disconnected would gate the PHY clocks.
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_IEEE802154_ENABLED=n
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n
# No PHY tracking timer: it would recalibrate the RF while receiving.
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
CONFIG_ESP_PHY_DEBUG=y
CONFIG_ESP_PHY_DISABLE_PLL_TRACK=y
CONFIG_PM_ENABLE=n
